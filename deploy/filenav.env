# /etc/filenav.env — configuration for filenav (all optional)

# Folder to manage
FILENAV_ROOT=/srv/files
# Where state.json (sessions, passkeys, share links) lives
FILENAV_DATA=/var/lib/filenav
# Listen only locally; put Caddy/nginx in front for HTTPS
FILENAV_ADDR=127.0.0.1:8080
# Your public URL — REQUIRED for passkeys and for correct share links
FILENAV_ORIGIN=https://files.example.com
# Behind a reverse proxy: trust X-Forwarded-* headers
FILENAV_TRUST_PROXY=true
# Upload chunk size in MiB (keep under 100 if behind Cloudflare)
FILENAV_CHUNK_MB=16
FILENAV_TITLE=My Files
# Initial passcode (only used on first start; change later in UI or `filenav passcode`)
#FILENAV_PASSCODE=change-me
