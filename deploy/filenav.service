[Unit]
Description=filenav - lightweight web file manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=filenav
Group=filenav
EnvironmentFile=-/etc/filenav.env
ExecStart=/usr/local/bin/filenav
Restart=on-failure
RestartSec=3

# Keep it tiny and contained
MemoryMax=128M
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Directories filenav may write to (adjust if you change FILENAV_ROOT / FILENAV_DATA)
ReadWritePaths=/srv/files /var/lib/filenav

[Install]
WantedBy=multi-user.target
